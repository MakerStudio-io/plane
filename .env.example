# Plane Environment Variables

# App Settings
APP_DOMAIN=localhost
APP_RELEASE=stable
SSL=false

# Service Replicas
WEB_REPLICAS=1
SPACE_REPLICAS=1
ADMIN_REPLICAS=1
API_REPLICAS=1
WORKER_REPLICAS=1
BEAT_WORKER_REPLICAS=1
LIVE_REPLICAS=1

# Port Settings
LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443

# Base URLs
API_BASE_URL=http://api:8000
WEB_URL=http://localhost
ADMIN_BASE_URL=http://localhost:3001
SPACE_BASE_URL=http://localhost:3002
LIVE_BASE_URL=http://localhost:3100
APP_BASE_URL=http://localhost:3000

# URL Paths
API_BASE_PATH=/
ADMIN_BASE_PATH=/god-mode
SPACE_BASE_PATH=/spaces
APP_BASE_PATH=/
LIVE_BASE_PATH=/live

# Debug Settings
DEBUG=0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3100

# Database Settings
POSTGRES_USER=plane
POSTGRES_PASSWORD=plane
POSTGRES_HOST=plane-db
POSTGRES_DB=plane
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis Settings
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/

# RabbitMQ Settings
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=plane
RABBITMQ_VHOST=plane
AMQP_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}/${RABBITMQ_VHOST}

# AWS/MinIO Settings
USE_MINIO=1
AWS_REGION=
AWS_ACCESS_KEY_ID=access-key
AWS_SECRET_ACCESS_KEY=secret-key
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=5242880

# Security Settings
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=*

# Gunicorn Settings
GUNICORN_WORKERS=2

# Live Server Settings
LIVE_SERVER_SECRET_KEY=live-secret-key
LIVE_PORT=3000
LIVE_HOSTNAME=plane-live

# Cleanup Settings
HARD_DELETE_AFTER_DAYS=60

# SSL Settings
MINIO_ENDPOINT_SSL=0

# API Rate Limiting
API_KEY_RATE_LIMIT=60/minute
